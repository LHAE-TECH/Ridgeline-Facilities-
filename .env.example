# ---- Core ----
NODE_ENV=production
PORT=3000
# Public base URL used in emails and Stripe redirects
APP_BASE_URL=https://app.ridgelinefacilities.com
DATABASE_URL=postgres://ridgeline:ridgeline@localhost:5432/ridgeline_dev
# Set DATABASE_SSL=true for most managed Postgres providers
DATABASE_SSL=false
# Long random string: openssl rand -hex 32
SESSION_SECRET=change-me
# First administrator created by `npm run seed` (only if no admin exists)
SEED_ADMIN_EMAIL=admin@ridgelinefacilities.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Ridgeline Administrator
# Run the background worker inside the web process (true for single-instance hosting)
RUN_WORKER_IN_PROCESS=true

# ---- Private file storage ----
# local = files stored on disk at UPLOAD_DIR (must be a persistent volume, never web-served)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2)
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=15

# ---- Email (unconfigured = notifications are recorded but NOT sent) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Ridgeline Facilities <accounts@ridgelinefacilities.com>"

# ---- Stripe card top-ups (optional; unconfigured = bank transfer only) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only for the live Stripe test-mode integration test (tests/stripe-live.test.ts); must be sk_test_…
STRIPE_TEST_SECRET_KEY=

# ---- SMS (Twilio; unconfigured = SMS recorded but NOT sent) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a NZ-capable Twilio number (+64…) or a Messaging Service SID
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Only for the live SMS test (tests/sms-live.test.ts, run with `npm run test:live`):
# a real NZ mobile to receive the test SMS, an optional undeliverable number, and an optional public URL
# forwarding to localhost:SMS_LIVE_PORT so Twilio's own status callback reaches the test.
SMS_TEST_MOBILE=
SMS_TEST_FAILING_NUMBER=
SMS_LIVE_PUBLIC_URL=
SMS_LIVE_PORT=3999

# ---- Xero (optional; Xero Custom Connection using client credentials) ----
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_SALES_ACCOUNT_CODE=200
XERO_COST_ACCOUNT_CODE=310
XERO_BANK_ACCOUNT_CODE=090
