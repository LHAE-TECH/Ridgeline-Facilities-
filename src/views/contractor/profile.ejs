<%- include('../partials/head', { title: 'Profile' }) %>
<h1>Profile &amp; compliance</h1>
<div class="grid-2">
  <div class="card"><h2>Availability &amp; details</h2>
    <form method="post" action="/c/profile" class="stack"><%- include('../partials/csrf') %>
      <label class="check"><input type="checkbox" name="available" <%= contractor.available ? 'checked' : '' %>> Available for new jobs</label>
      <label class="check"><input type="checkbox" name="after_hours" <%= contractor.after_hours_available ? 'checked' : '' %>> Available after hours / weekends</label>
      <label class="check"><input type="checkbox" name="emergency" <%= contractor.emergency_available ? 'checked' : '' %>> Available for emergencies</label>
      <div class="grid-2"><div><label>Phone</label><input name="phone" value="<%= contractor.phone || '' %>"></div>
      <div><label>Mobile for SMS job offers</label><input name="mobile_phone" type="tel" value="<%= contractor.mobile_phone || '' %>" placeholder="021 555 0199"><div class="field-hint">Required for P1 emergency offers.</div></div></div>
      <div class="grid-2"><div><label>Bank account name</label><input name="bank_account_name" value="<%= contractor.bank_account_name || '' %>"></div><div><label>Bank account number</label><input name="bank_account_number" value="<%= contractor.bank_account_number || '' %>"></div></div>
      <button type="submit">Save</button>
    </form>
    <dl class="kv" style="margin-top:1rem"><dt>Legal name</dt><dd><%= contractor.legal_name %></dd><dt>NZBN</dt><dd><%= contractor.nzbn || '—' %></dd><dt>GST</dt><dd><%= contractor.gst_registered ? contractor.gst_number : 'Not registered' %></dd><dt>Payment terms</dt><dd><%= contractor.payment_terms_days %> days from invoice</dd><dt>Regions</dt><dd><%= contractor.service_regions.join(', ') %></dd></dl>
    <p class="field-hint">Contact Ridgeline to change legal, GST, region or payment-term details.</p>
  </div>
  <div class="card"><h2>Trades &amp; agreed rates</h2>
    <% trades.forEach(function (t) { %><p><%= t.name %> <%- include('../partials/status', { s: t.verified ? 'verified' : 'pending' }) %></p><% }) %>
    <div class="table-wrap"><table><tr><th>Trade</th><th class="num">Labour/h</th><th class="num">Callout</th><th class="num">Emergency</th><th>Status</th></tr>
    <% rateCards.forEach(function (r) { %><tr><td><%= r.trade_name %></td><td class="num"><%= money(r.labour_rate_cents) %></td><td class="num"><%= money(r.callout_cents) %></td><td class="num"><%= money(r.emergency_callout_cents) %></td><td><%- include('../partials/status', { s: r.status }) %></td></tr><% }) %></table></div>
  </div>
</div>
<div class="card"><h2>Compliance documents</h2>
  <div class="table-wrap"><table><tr><th>Document</th><th>Reference</th><th>Expires</th><th>Status</th><th>File</th></tr>
  <% documents.forEach(function (d) { %><tr><td><%= documentTypes[d.doc_type] || d.doc_type %></td><td><%= d.reference || '—' %></td><td><%= date(d.expires_at) %></td><td><%- include('../partials/status', { s: d.status }) %></td><td><% if (d.file_id) { %><a href="/files/<%= d.file_id %>">View</a><% } %></td></tr><% }) %></table></div>
  <form method="post" action="/c/documents" enctype="multipart/form-data" class="stack"><%- include('../partials/csrf') %>
    <div class="grid-3"><div><label>Document type</label><select name="doc_type"><% Object.keys(documentTypes).forEach(function (k) { %><option value="<%= k %>"><%= documentTypes[k] %></option><% }) %></select></div>
    <div><label>Policy / licence number</label><input name="reference"></div><div><label>Expiry date</label><input name="expires_at" type="date"></div></div>
    <input type="file" name="file" accept="application/pdf,image/*" required>
    <button type="submit" class="secondary">Upload for verification</button>
  </form>
</div>
<%- include('../partials/foot') %>
