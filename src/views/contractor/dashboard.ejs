<%- include('../partials/head', { title: 'Jobs' }) %>
<div class="page-head"><div><h1>Jobs</h1><small><%= contractor.legal_name %> · <%- include('../partials/status', { s: contractor.status }) %> · <%= contractor.available ? 'Available' : 'Unavailable' %></small></div></div>
<% if (contractor.status !== 'approved') { %><div class="notice">Your account is <%= contractor.status %>. Upload your insurance and licences on the <a href="/c/profile">Profile</a> page; Ridgeline will verify them and agree rates before offering jobs.</div><% } %>
<% expiring.forEach(function (d) { %><div class="notice err"><%= humanize(d.doc_type) %> expires <%= date(d.expires_at) %>. <a href="/c/profile">Upload the renewal</a> to keep receiving jobs.</div><% }) %>
<div class="card"><h2>Job offers (<%= offers.length %>)</h2>
<% if (!offers.length) { %><p class="muted">No open offers right now.</p><% } %>
<% offers.forEach(function (o) { %>
  <div class="job-card <%= o.priority %>">
    <strong><%= o.ref %>: <%= o.title %></strong> <span class="badge <%= o.priority === 'emergency' ? 'err' : o.priority === 'urgent' ? 'warn' : '' %>"><%= humanize(o.priority) %></span><br>
    <small><%= o.trade_name %> · <%= [o.suburb, o.city, o.region].filter(Boolean).join(', ') %> · preferred <%= dt(o.preferred_start) %> · offer expires <%= dt(o.expires_at) %></small>
    <p><%= o.description %></p>
    <div class="actions">
      <form method="post" action="/c/offers/<%= o.id %>/accept"><%- include('../partials/csrf') %><button type="submit">Accept job</button></form>
      <form method="post" action="/c/offers/<%= o.id %>/decline" class="inline-form"><%- include('../partials/csrf') %><input name="reason" placeholder="Reason (optional)"><button type="submit" class="secondary">Decline</button></form>
      <a class="btn secondary" href="/c/jobs/<%= o.job_id %>">Details</a>
    </div>
  </div>
<% }) %></div>
<div class="card"><h2>My jobs</h2><div class="table-wrap"><table><tr><th>Job</th><th>Site</th><th>Status</th><th>Updated</th></tr>
<% jobs.forEach(function (j) { %><tr><td><a href="/c/jobs/<%= j.id %>"><%= j.ref %></a><br><small><%= j.title %></small></td><td><%= j.site_name %><br><small><%= j.site_address %></small></td><td><%- include('../partials/status', { s: j.status }) %></td><td><%= dt(j.updated_at) %></td></tr><% }) %>
<% if (!jobs.length) { %><tr><td colspan="4" class="muted">No assigned jobs.</td></tr><% } %></table></div></div>
<%- include('../partials/foot') %>
