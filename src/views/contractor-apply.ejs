<%- include('partials/head', { title: 'Contractor application' }) %>
<div class="card" style="max-width:820px;margin:0 auto">
  <h1>Join the Ridgeline contractor network</h1>
  <p class="muted">You invoice Ridgeline Facilities directly for approved work at your agreed rates. After applying, sign in to upload insurance and licences for verification.</p>
  <form method="post" action="/contractors/apply" class="stack">
    <%- include('partials/csrf') %>
    <div class="grid-2">
      <div><label>Legal business name</label><input name="legal_name" required></div>
      <div><label>Trading name</label><input name="trading_name"></div>
      <div><label>NZBN</label><input name="nzbn"></div>
      <div><label>Business address</label><input name="address"></div>
      <div><label>Contact name</label><input name="contact_name" required></div>
      <div><label>Phone</label><input name="phone" type="tel" required></div>
      <div><label>Email (login)</label><input name="email" type="email" required></div>
      <div><label>Password (10+ characters)</label><input name="password" type="password" minlength="10" required></div>
    </div>
    <label class="check"><input type="checkbox" name="gst_registered"> GST registered</label>
    <div class="grid-2">
      <div><label>GST number (if registered)</label><input name="gst_number"></div>
      <div></div>
      <div><label>Bank account name</label><input name="bank_account_name"></div>
      <div><label>Bank account number</label><input name="bank_account_number" placeholder="00-0000-0000000-00"></div>
    </div>
    <fieldset class="card"><legend><strong>Trades</strong></legend><div class="grid-3">
      <% trades.forEach(function (t) { %><label class="check"><input type="checkbox" name="trades" value="<%= t.id %>"> <%= t.name %></label><% }) %></div></fieldset>
    <fieldset class="card"><legend><strong>Service regions</strong></legend><div class="grid-3">
      <% regions.forEach(function (r) { %><label class="check"><input type="checkbox" name="regions" value="<%= r %>"> <%= r %></label><% }) %></div></fieldset>
    <label class="check"><input type="checkbox" name="after_hours"> Available after hours and weekends</label>
    <label class="check"><input type="checkbox" name="emergency"> Available for emergency callouts</label>
    <label class="check"><input type="checkbox" name="ack" required> I operate as an independent contractor in my own business, hold the insurance and licences required for my trades, and am responsible for my own tax and health &amp; safety obligations.</label>
    <button type="submit">Submit application</button>
  </form>
</div>
<%- include('partials/foot') %>
