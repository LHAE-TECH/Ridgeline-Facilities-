<%- include('../partials/head', { title: 'Staff users' }) %>
<h1>Staff users</h1>
<% if (!holdAlerts.onCallCount) { %><div class="notice err">Nobody holds the <strong>on-call P1 release</strong> right. A P1 held at the unfunded threshold can then only be released by finance or an administrator.</div><% } %>
<% if (holdAlerts.alertedWithoutAuthority.length) { %><div class="notice warn">These escalation phones receive P1 hold alerts but belong to nobody with the on-call release right: <%= holdAlerts.alertedWithoutAuthority.join(', ') %>. Grant the right to the person carrying that phone, or remove the number from <code>escalation_staff_phones</code>.</div><% } %>
<div class="card"><div class="table-wrap"><table><tr><th>Name</th><th>Email</th><th>Role</th><th>On-call P1 release</th><th>Last sign-in</th><th></th></tr>
<% users.forEach(function (u) { %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td>
<td><form method="post" action="/admin/users/<%= u.id %>/on-call" class="inline-form"><%- include('../partials/csrf') %>
  <input name="phone" value="<%= u.phone || '' %>" placeholder="NZ mobile" size="12"><input type="hidden" name="on_call" value="<%= u.on_call_p1_release ? 'false' : 'true' %>">
  <button class="small secondary" type="submit"><%= u.on_call_p1_release ? 'Remove right' : 'Grant right' %></button></form><% if (u.on_call_p1_release) { %> <span class="badge ok">on call</span><% } %></td>
<td><%= dt(u.last_login_at) %></td><td><form method="post" action="/admin/users/<%= u.id %>/active" class="inline-form"><%- include('../partials/csrf') %><input type="hidden" name="active" value="<%= u.is_active ? 'false' : 'true' %>"><button class="small secondary" type="submit"><%= u.is_active ? 'Deactivate' : 'Reactivate' %></button></form></td></tr><% }) %></table></div>
<p class="field-hint">On-call P1 release: the holder receives the SMS when a P1 is held at the unfunded threshold and can release it for make-safe work only, with a reason (audited).</p></div>
<div class="card"><h2>Add staff user</h2><form method="post" action="/admin/users" class="stack"><%- include('../partials/csrf') %><div class="grid-2"><input name="name" placeholder="Name" required><input name="email" type="email" placeholder="Email" required>
<select name="role"><option value="ops">Operations – dispatch, evidence review, contractor compliance</option><option value="finance">Finance – invoices, payments, refunds</option><option value="admin">Administrator – everything incl. pricing &amp; settings</option></select><input name="password" type="password" minlength="10" placeholder="Temporary password" required>
<input name="phone" placeholder="NZ mobile (needed for on-call)"></div><button type="submit">Create user</button></form></div>
<%- include('../partials/foot') %>
