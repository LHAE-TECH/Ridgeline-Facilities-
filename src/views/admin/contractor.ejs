<%- include('../partials/head', { title: contractor.legal_name }) %>
<div class="page-head"><div><h1><%= contractor.legal_name %></h1><small><%= contractor.email %> · <%= contractor.phone || '' %> · <%- include('../partials/status', { s: contractor.status }) %><% if (contractor.independent_contractor_ack_at) { %> · independent contractor declaration <%= date(contractor.independent_contractor_ack_at) %><% } %></small></div>
<form method="post" action="/admin/contractors/<%= contractor.id %>/status" class="inline-form"><%- include('../partials/csrf') %>
  <% if (contractor.status !== 'approved') { %><button name="status" value="approved" type="submit">Approve</button><% } %>
  <% if (contractor.status !== 'suspended') { %><button name="status" value="suspended" type="submit" class="danger">Suspend</button><% } %></form></div>
<div class="grid-2">
  <div class="card"><h2>Details</h2>
  <form method="post" action="/admin/contractors/<%= contractor.id %>" class="stack"><%- include('../partials/csrf') %>
    <div class="grid-2"><div><label>Legal name</label><input name="legal_name" value="<%= contractor.legal_name %>"></div><div><label>Trading name</label><input name="trading_name" value="<%= contractor.trading_name || '' %>"></div>
    <div><label>NZBN</label><input name="nzbn" value="<%= contractor.nzbn || '' %>"></div><div><label>Phone</label><input name="phone" value="<%= contractor.phone || '' %>"></div>
    <div><label>Mobile for SMS dispatch</label><input name="mobile_phone" type="tel" value="<%= contractor.mobile_phone || '' %>"></div><div><label>Agreement</label><p><%= contractor.agreement_version ? 'Accepted ' + contractor.agreement_version + ' on ' + date(contractor.agreement_accepted_at) : 'Not yet accepted' %></p></div>
    <div><label>GST number</label><input name="gst_number" value="<%= contractor.gst_number || '' %>"></div><div><label class="check"><input type="checkbox" name="gst_registered" <%= contractor.gst_registered ? 'checked' : '' %>> GST registered</label></div>
    <div><label>Bank account name</label><input name="bank_account_name" value="<%= contractor.bank_account_name || '' %>"></div><div><label>Bank account number</label><input name="bank_account_number" value="<%= contractor.bank_account_number || '' %>"></div>
    <div><label>Payment terms (days)</label><input name="payment_terms_days" type="number" value="<%= contractor.payment_terms_days %>"></div><div><label>Max concurrent jobs</label><input name="max_concurrent_jobs" type="number" value="<%= contractor.max_concurrent_jobs %>"></div>
    <div><label>Service radius (km, needs base location)</label><input name="service_radius_km" type="number" value="<%= contractor.service_radius_km || '' %>"></div></div>
    <details><summary>Regions (<%= contractor.service_regions.length %>)</summary><div class="grid-3"><% regions.forEach(function (r) { %><label class="check"><input type="checkbox" name="regions" value="<%= r %>" <%= contractor.service_regions.includes(r) ? 'checked' : '' %>> <%= r %></label><% }) %></div></details>
    <label class="check"><input type="checkbox" name="available" <%= contractor.available ? 'checked' : '' %>> Available</label>
    <label class="check"><input type="checkbox" name="after_hours" <%= contractor.after_hours_available ? 'checked' : '' %>> After-hours</label>
    <label class="check"><input type="checkbox" name="emergency" <%= contractor.emergency_available ? 'checked' : '' %>> Emergency</label>
    <button type="submit">Save</button></form></div>
  <div class="card"><h2>Trades &amp; qualifications</h2>
    <% trades.forEach(function (t) { %><form method="post" action="/admin/contractors/<%= contractor.id %>/trades" class="inline-form"><%- include('../partials/csrf') %><input type="hidden" name="trade_id" value="<%= t.trade_id %>">
      <span><%= t.name %></span> <%- include('../partials/status', { s: t.verified ? 'verified' : 'pending' }) %><input name="qualification" value="<%= t.qualification || '' %>" placeholder="Qualification ref">
      <label class="check"><input type="checkbox" name="verified" <%= t.verified ? 'checked' : '' %>> Verified</label><button class="small secondary" type="submit">Save</button><button class="small secondary" name="remove" value="on" type="submit">Remove</button></form><% }) %>
    <form method="post" action="/admin/contractors/<%= contractor.id %>/trades" class="inline-form"><%- include('../partials/csrf') %><select name="trade_id"><% allTrades.forEach(function (t) { %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select><input name="qualification" placeholder="Qualification"><label class="check"><input type="checkbox" name="verified"> Verified</label><button class="small" type="submit">Add trade</button></form>
  </div>
</div>
<div class="card"><h2>Agreed rate cards (contractor cost to Ridgeline, ex GST)</h2>
<div class="table-wrap"><table><tr><th>Trade</th><th class="num">Labour/h</th><th class="num">Callout</th><th class="num">Emergency callout</th><th>After-hrs / Wknd / Hol / Night</th><th class="num">Travel/km</th><th class="num">Min</th><th class="num">Cancel fee</th><th>Status</th></tr>
<% rateCards.forEach(function (r) { %><tr><td><%= r.trade_name %></td><td class="num"><%= money(r.labour_rate_cents) %></td><td class="num"><%= money(r.callout_cents) %></td><td class="num"><%= money(r.emergency_callout_cents) %></td><td><%= mult(r.after_hours_multiplier_bps) %> / <%= mult(r.weekend_multiplier_bps) %> / <%= mult(r.public_holiday_multiplier_bps) %> / <%= mult(r.overnight_multiplier_bps) %></td><td class="num"><%= money(r.travel_per_km_cents) %></td><td class="num"><%= money(r.min_charge_cents) %></td><td class="num"><%= money(r.cancellation_fee_cents) %></td><td><%- include('../partials/status', { s: r.status }) %></td></tr><% }) %></table></div>
<% if (actor.role !== 'finance') { %>
<form method="post" action="/admin/contractors/<%= contractor.id %>/rate-cards" class="stack"><%- include('../partials/csrf') %>
  <div class="grid-3"><div><label>Trade</label><select name="trade_id"><% allTrades.forEach(function (t) { %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></div>
  <div><label>Labour rate /h</label><input name="labour_rate" inputmode="decimal" required></div><div><label>Callout</label><input name="callout" inputmode="decimal"></div>
  <div><label>Emergency callout</label><input name="emergency_callout" inputmode="decimal"></div><div><label>After-hours multiplier</label><input name="after_hours_multiplier" value="1.5"></div><div><label>Weekend multiplier</label><input name="weekend_multiplier" value="1.5"></div>
  <div><label>Public holiday multiplier</label><input name="public_holiday_multiplier" value="2"></div><div><label>Overnight multiplier</label><input name="overnight_multiplier" value="2"></div><div><label>Travel per km</label><input name="travel_per_km" inputmode="decimal"></div>
  <div><label>Minimum charge</label><input name="min_charge" inputmode="decimal"></div><div><label>Materials margin %</label><input name="materials_margin" value="0"></div><div><label>Cancellation fee</label><input name="cancellation_fee" inputmode="decimal"></div></div>
  <button type="submit" class="secondary">Agree new rate card (replaces current for that trade)</button></form><% } %></div>
<div class="card"><h2>Compliance documents</h2><div class="table-wrap"><table><tr><th>Document</th><th>Reference</th><th>Expires</th><th>Status</th><th>File</th><th></th></tr>
<% documents.forEach(function (d) { const expired = d.expires_at && d.expires_at < new Date().toISOString().slice(0,10); %><tr><td><%= documentTypes[d.doc_type] || d.doc_type %></td><td><%= d.reference || '—' %></td><td><%= date(d.expires_at) %><% if (expired) { %> <span class="badge err">Expired</span><% } %></td><td><%- include('../partials/status', { s: d.status }) %></td><td><% if (d.file_id) { %><a href="/files/<%= d.file_id %>" target="_blank">View</a><% } %></td>
<td><% if (d.status === 'pending' && actor.role !== 'finance') { %><form method="post" action="/admin/documents/<%= d.id %>/review" class="inline-form"><%- include('../partials/csrf') %><button name="decision" value="verified" class="small" type="submit">Verify</button><button name="decision" value="rejected" class="small secondary" type="submit">Reject</button></form><% } %></td></tr><% }) %></table></div>
<form method="post" action="/admin/contractors/<%= contractor.id %>/documents" enctype="multipart/form-data" class="inline-form"><%- include('../partials/csrf') %>
  <select name="doc_type"><% Object.keys(documentTypes).forEach(function (k) { %><option value="<%= k %>"><%= documentTypes[k] %></option><% }) %></select><input name="reference" placeholder="Reference"><input name="expires_at" type="date"><input type="file" name="file" accept="application/pdf,image/*"><button class="small secondary" type="submit">Add document</button></form></div>
<div class="card"><h2>Payables</h2><div class="table-wrap"><table><% payables.forEach(function (p) { %><tr><td><%= p.invoice_number %> (<%= p.job_ref %>)</td><td class="num"><%= money(payableAmount(p)) %></td><td><%= date(p.due_date) %></td><td><%- include('../partials/status', { s: p.status }) %></td></tr><% }) %></table></div></div>
<%- include('../partials/foot') %>
