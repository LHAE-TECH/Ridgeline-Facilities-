<%- include('../partials/head', { title: 'Operations dashboard' }) %>
<div class="page-head"><div><h1>Operations dashboard</h1><small>Period <%= date(d.period.from) %> – <%= date(d.period.to) %></small></div>
<form class="inline-form" method="get"><input type="date" name="from" value="<%= d.period.from %>"><input type="date" name="to" value="<%= d.period.to %>"><button class="secondary" type="submit">Apply</button></form></div>
<% const unconfigured = Object.entries(integrations).filter(function (e) { return e[1].mode === 'unconfigured'; }); if (unconfigured.length) { %>
<div class="notice">Unconfigured integrations: <%= unconfigured.map(function (e) { return e[0]; }).join(', ') %>. <a href="/admin/integrations">Details</a></div><% } %>

<h2>Customer accounts</h2>
<div class="stats">
  <div class="stat"><div class="label">Active accounts</div><div class="value"><%= d.accounts.active %></div><div class="sub"><%= d.accounts.onboarding %> onboarding · <%= d.accounts.suspended %> suspended</div></div>
  <div class="stat"><div class="label">Facilities &amp; units</div><div class="value"><%= d.facilities.units %> units</div><div class="sub"><%= d.facilities.facilities %> facilities · <%= d.facilities.sites %> sites</div></div>
  <div class="stat"><div class="label">Required minimum balances</div><div class="value"><%= money(d.accounts.required_minimum) %></div><div class="sub"><%= d.accounts.custom_arrangements %> custom arrangement(s)</div></div>
  <div class="stat"><div class="label">Customer prepaid balances</div><div class="value"><%= money(d.balanceSheet.customerPrepaidLiability) %></div><div class="sub">Liability, not revenue</div></div>
  <div class="stat"><div class="label">Committed / available</div><div class="value"><%= money(d.accounts.available) %></div><div class="sub"><%= money(d.accounts.committed) %> committed</div></div>
  <div class="stat <%= d.accounts.low_balance ? 'alert' : '' %>"><div class="label">Low-balance accounts</div><div class="value"><%= d.accounts.low_balance %></div></div>
</div>

<h2>Jobs</h2>
<div class="stats">
  <div class="stat"><div class="label">Awaiting funds / approval</div><div class="value"><%= d.jobs.awaitingFunds %></div></div>
  <div class="stat"><div class="label">Awaiting dispatch</div><div class="value"><a href="/admin/dispatch"><%= d.jobs.awaitingDispatch %></a></div></div>
  <div class="stat"><div class="label">In progress</div><div class="value"><%= d.jobs.inProgress %></div></div>
  <div class="stat"><div class="label">Awaiting evidence review</div><div class="value"><a href="/admin/jobs?status=evidence_submitted"><%= d.jobs.awaitingEvidence %></a></div></div>
  <div class="stat <%= d.overdue.length ? 'alert' : '' %>"><div class="label">SLA at risk / breached now</div><div class="value"><%= d.overdue.length %></div><div class="sub"><%= d.slaBreaches.breached %> breached · <%= d.slaBreaches.escalated %> escalated in period</div></div>
  <div class="stat <%= d.disputes ? 'alert' : '' %>"><div class="label">Open disputes</div><div class="value"><a href="/admin/disputes"><%= d.disputes %></a></div></div>
</div>

<h2>Make-safe contractor coverage</h2>
<% if (!d.coverage.goLiveReady) { %><div class="notice err"><strong>Go-live gate 5 not met:</strong>
  <% if (d.coverage.contractorsNotOnCurrentAgreement.length) { %><%= d.coverage.contractorsNotOnCurrentAgreement.length %> approved contractor(s) not on the current agreement. <% } %>
  <% if (d.coverage.areasWithNone.length) { %>No make-safe-eligible contractor in: <%= d.coverage.areasWithNone.join(', ') %>.<% } %></div><% } %>
<% if (d.coverage.areasBelowTwo.length) { %><div class="notice warn">Fewer than two make-safe-eligible contractors in: <strong><%= d.coverage.areasBelowTwo.join(', ') %></strong>.</div><% } %>
<div class="card"><div class="table-wrap"><table><tr><th>Area</th><th class="num">P1 on-site target</th><th class="num">Eligible</th><th class="num">Blocked by agreement version</th><th>Blocked contractors</th></tr>
<% d.coverage.areas.forEach(function (a) { %><tr><td><%= a.name %> <small class="muted"><%= a.metro ? 'metro' : 'non-metro' %></small></td><td class="num"><%= a.targetMinutes / 60 %> h</td>
<td class="num"><span class="badge <%= a.zero ? 'err' : a.warning ? 'warn' : 'ok' %>"><%= a.eligibleCount %></span></td><td class="num"><%= a.blockedCount %></td>
<td><% a.blocked.forEach(function (b, i) { %><%= i ? ', ' : '' %><a href="/admin/contractors/<%= b.id %>"><%= b.name %></a> (<%= b.version || 'none' %>)<% }) %><%= a.hasCentre ? '' : 'No reference point set for this area' %></td></tr><% }) %></table></div>
<p class="field-hint">Counts approved, P1-capable contractors who cover the area and could reach its reference point within the P1 on-site target at <%= settings.travel_speed_kmh %> km/h. "Blocked": their agreement version lacks the make-safe clause or is superseded, so they are never sent make-safe jobs.
<% if (d.coverage.baseUnknown.length) { %> Not placed (no base location): <%= d.coverage.baseUnknown.map(function (c) { return c.name; }).join(', ') %>.<% } %></p></div>

<% if (d.supersededTerms.length) { %><h2>Booked under superseded terms</h2><div class="card"><div class="table-wrap"><table><tr><th>Job</th><th>Customer</th><th>Terms at booking</th><th>Invoice</th></tr>
<% d.supersededTerms.forEach(function (j) { %><tr><td><a href="/admin/jobs/<%= j.id %>"><%= j.ref %></a> <%= j.title %></td><td><a href="/admin/customers/<%= j.customer_id %>"><%= j.customer_name %></a></td><td><%= j.terms_version_at_booking || 'none' %></td>
<td><% if (!j.invoice_id) { %>not drafted<% } else if (j.invoice_status === 'draft') { %><a href="/admin/customer-invoices/<%= j.invoice_id %>">held for review</a><% } else { %><a href="/admin/customer-invoices/<%= j.invoice_id %>"><%= j.invoice_status %></a><%= j.superseded_terms_issue_reason ? ' (issued with reason)' : '' %><% } %></td></tr><% }) %></table></div>
<p class="field-hint">Listed until the customer accepts the current terms.</p></div><% } %>

<h2>Unfunded emergency exposure</h2>
<div class="stats">
  <div class="stat <%= d.unfundedP1.totalCents ? 'alert' : '' %>"><div class="label">Total unfunded P1 exposure</div><div class="value"><%= money(d.unfundedP1.totalCents) %></div>
    <div class="sub"><%= money(d.unfundedP1.openUnfundedCents) %> on <%= d.unfundedP1.openJobs %> open job(s) · <%= money(d.unfundedP1.invoicedUnpaidCents) %> invoiced, unpaid</div></div>
  <div class="stat <%= d.unfundedP1.suspendedCustomers ? 'alert' : '' %>"><div class="label">Customers with unfunded P1 dispatch suspended</div><div class="value"><%= d.unfundedP1.suspendedCustomers %></div></div>
</div>
<div class="stats">
  <div class="stat <%= d.p1Holds.stillHeld ? 'alert' : '' %>"><div class="label">P1 held at threshold (booked in period)</div><div class="value"><%= d.p1Holds.count %></div>
    <div class="sub"><%= d.p1Holds.stillHeld %> still held · avg hold <%= d.p1Holds.avgHoldMinutes === null ? '—' : d.p1Holds.avgHoldMinutes + ' min' %> · longest <%= d.p1Holds.maxHoldMinutes === null ? '—' : d.p1Holds.maxHoldMinutes + ' min' %></div></div>
  <div class="stat"><div class="label">Follow-ups after make-safe: open, within age limit</div><div class="value"><a href="/admin/follow-ups"><%= d.followUps.current %></a></div></div>
  <div class="stat <%= d.followUps.aged ? 'alert' : '' %>"><div class="label">Aged follow-ups (<%= settings.follow_up_flag_days %>+ days)</div><div class="value"><%= d.followUps.aged %></div></div>
  <div class="stat <%= d.followUps.escalated ? 'alert' : '' %>"><div class="label">Escalated follow-ups (<%= settings.follow_up_escalate_days %>+ days)</div><div class="value"><%= d.followUps.escalated %></div></div>
</div>
<% if (d.followUps.agedList.length) { %><div class="card"><h3>Aged follow-ups (outstanding hazards after make-safe)</h3><div class="table-wrap"><table><tr><th>Job</th><th>Customer</th><th>Outstanding</th><th class="num">Age</th><th></th></tr>
<% d.followUps.agedList.forEach(function (f) { %><tr><td><a href="/admin/jobs/<%= f.job_id %>"><%= f.job_ref %></a></td><td><%= f.customer_name %></td><td><%= f.description %></td><td class="num"><%= f.age_days %> days</td>
<td><span class="badge <%= f.band === 'escalated' ? 'err' : 'warn' %>"><%= f.band %></span></td></tr><% }) %></table></div></div><% } %>
<% if (d.p1Holds.jobs.length) { %><div class="card"><h3>P1 holds (clock not paused)</h3><div class="table-wrap"><table><tr><th>Job</th><th>Customer</th><th class="num">Held</th><th>Ended</th><th>SLA</th></tr>
<% d.p1Holds.jobs.forEach(function (j) { %><tr><td><a href="/admin/jobs/<%= j.id %>"><%= j.ref %></a></td><td><%= j.customer_name %></td><td class="num"><%= j.hold_minutes %> min</td>
<td><%= j.p1_hold_released_at ? humanize(j.p1_hold_release_kind) : 'STILL HELD' %></td><td><%= j.sla_onsite_met === null ? 'open' : j.sla_onsite_met ? 'on-site met' : 'on-site missed' %></td></tr><% }) %></table></div></div><% } %>
<% if (d.unfundedP1.customers.length) { %><div class="card"><div class="table-wrap"><table><tr><th>Customer</th><th class="num">Open unfunded</th><th class="num">Invoiced unpaid (P1)</th><th class="num">Unfunded balance / threshold</th></tr>
<% d.unfundedP1.customers.forEach(function (c) { %><tr><td><a href="/admin/customers/<%= c.id %>"><%= c.name %></a></td><td class="num"><%= money(c.openUnfundedCents) %></td><td class="num"><%= money(c.invoicedUnpaidCents) %></td>
<td class="num"><%= money(c.unfundedBalanceCents) %> / <%= money(c.thresholdCents) %><% if (c.suspended) { %> <span class="badge err">suspended</span><% } %></td></tr><% }) %></table></div></div><% } %>

<h2>SLA performance (clock started in period)</h2>
<div class="card"><div class="table-wrap"><table><tr><th>Priority</th><th class="num">Jobs</th><th class="num">On site in target</th><th class="num">Resolved / made safe in target</th><th class="num">Avg time to site</th></tr>
<% d.sla.forEach(function (r) { %><tr><td><%= r.code %> <%= r.label %></td><td class="num"><%= r.jobs %></td>
  <td class="num"><% if (r.onsitePct === null) { %>—<% } else { %><span class="badge <%= r.onsitePct >= 95 ? 'ok' : r.onsitePct >= 85 ? 'warn' : 'err' %>"><%= r.onsitePct %>%</span> <small><%= r.onsiteMet %>/<%= r.onsiteMeasured %></small><% } %></td>
  <td class="num"><% if (r.resolvePct === null) { %>—<% } else { %><span class="badge <%= r.resolvePct >= 95 ? 'ok' : r.resolvePct >= 85 ? 'warn' : 'err' %>"><%= r.resolvePct %>%</span> <small><%= r.resolveMet %>/<%= r.resolveMeasured %></small><% } %></td>
  <td class="num"><%= r.avgMinutesToSite === null ? '—' : Math.floor(r.avgMinutesToSite / 60) + 'h ' + (r.avgMinutesToSite % 60) + 'm' %></td></tr><% }) %></table></div>
<p class="field-hint">A target is counted once the visit/resolution happens or its due time passes. Cancelled jobs are excluded.</p></div>

<h2>Invoicing &amp; payments</h2>
<div class="stats">
  <div class="stat"><div class="label">Contractor invoices to approve</div><div class="value"><a href="/admin/contractor-invoices"><%= d.contractorInvoices.awaiting %></a></div><div class="sub"><%= d.contractorInvoices.flagged %> flagged</div></div>
  <div class="stat"><div class="label">Customer invoices issued</div><div class="value"><%= d.customerInvoices.issued_in_period %></div><div class="sub"><%= d.customerInvoices.drafts %> draft(s) to issue</div></div>
  <div class="stat"><div class="label">Outstanding receivables</div><div class="value"><%= money(d.balanceSheet.receivables) %></div><div class="sub"><%= d.customerInvoices.overdue %> overdue invoice(s)</div></div>
  <div class="stat"><div class="label">Approved contractor payables</div><div class="value"><%= money(d.payables.approved_unpaid) %></div><div class="sub"><%= d.payables.on_hold %> on hold</div></div>
  <div class="stat"><div class="label">Contractor payments due (7 days)</div><div class="value"><%= money(d.payables.due_7_days) %></div><div class="sub"><%= d.payables.overdue %> overdue</div></div>
  <div class="stat"><div class="label">Contractor payments completed</div><div class="value"><%= money(d.payables.paidInPeriod) %></div><div class="sub"><%= d.payables.paidCountInPeriod %> confirmed in period</div></div>
</div>

<h2>Margin (invoiced in period, excl GST)</h2>
<div class="stats">
  <div class="stat"><div class="label">Customer selling price</div><div class="value"><%= money(d.margin.sellingPriceExGst) %></div><div class="sub"><%= d.margin.invoices %> invoices<% if (d.margin.creditNotes) { %>, net of <%= money(d.margin.creditNotes) %> credits<% } %></div></div>
  <div class="stat"><div class="label">Contractor cost</div><div class="value"><%= money(d.margin.contractorCostExGst) %></div></div>
  <div class="stat"><div class="label">Markup / gross profit</div><div class="value"><%= money(d.margin.grossProfit) %></div><div class="sub">Before overheads</div></div>
  <div class="stat"><div class="label">Gross margin</div><div class="value"><%= bps(d.margin.grossMarginBps) %></div><div class="sub">Of selling price (35% markup ≈ 25.93%)</div></div>
</div>
<div class="grid-2">
  <div class="card"><h2>Standard vs premium-time costs</h2><div class="table-wrap"><table><tr><th>Time window</th><th class="num">Contractor cost</th><th class="num">Customer price</th></tr>
  <% d.byWindow.forEach(function (w) { %><tr><td><%= windowLabel(w.time_window) %></td><td class="num"><%= money(w.contractor_cost) %></td><td class="num"><%= money(w.customer_price) %></td></tr><% }) %>
  <% if (!d.byWindow.length) { %><tr><td colspan="3" class="muted">No approved contractor invoices in period.</td></tr><% } %></table></div></div>
  <div class="card"><h2>Financial position (all time)</h2><dl class="kv">
    <dt>Cash (bank + card clearing)</dt><dd><%= money(d.balanceSheet.cash) %></dd>
    <dt>Customer prepaid liability</dt><dd><%= money(d.balanceSheet.customerPrepaidLiability) %></dd>
    <dt>Customer receivables</dt><dd><%= money(d.balanceSheet.receivables) %></dd>
    <dt>Contractor payables</dt><dd><%= money(d.balanceSheet.contractorPayables) %></dd>
    <dt>Net GST payable</dt><dd><%= money(d.balanceSheet.gstPayableNet) %></dd>
    <dt>Revenue</dt><dd><%= money(d.profitAllTime.revenue) %></dd>
    <dt>Contractor costs</dt><dd><%= money(d.profitAllTime.contractorCosts) %></dd>
    <dt>Gross profit</dt><dd><strong><%= money(d.profitAllTime.grossProfit) %></strong></dd></dl>
    <p class="field-hint">Customer deposits and top-ups are held as a liability and are never counted as revenue or profit.</p></div>
</div>
<div class="grid-2">
  <div class="card"><h2>Low-balance accounts</h2><% d.lowBalance.forEach(function (c) { %><p><a href="/admin/customers/<%= c.id %>"><%= c.name %></a> · <%= money(c.prepaid_balance_cents) %> of <%= money(c.agreed_minimum_balance_cents) %></p><% }) %><% if (!d.lowBalance.length) { %><p class="muted">None</p><% } %></div>
  <div class="card"><h2>Area unconfirmed</h2>
    <p class="field-hint">Not counted in SLA performance until the site's area is confirmed.</p>
    <% d.areaUnconfirmed.sites.forEach(function (s) { %><p><a href="/admin/customers/<%= s.customer_id %>"><%= s.customer_name %></a> · <%= s.name %>, <%= s.suburb || 'no suburb' %> <span class="badge warn">confirm area</span></p><% }) %>
    <% d.areaUnconfirmed.jobs.forEach(function (j) { %><p><a href="/admin/jobs/<%= j.id %>"><%= j.ref %></a> · <%= prio(j.priority) %> · <%= j.site_name %> (<%= j.suburb || '—' %>)</p><% }) %>
    <% if (!d.areaUnconfirmed.sites.length && !d.areaUnconfirmed.jobs.length) { %><p class="muted">None</p><% } %></div>
  <div class="card"><h2>SLA at risk or breached</h2><% d.overdue.forEach(function (j) { %><p><a href="/admin/jobs/<%= j.id %>"><%= j.ref %></a> · <%= prio(j.priority) %> · <%= statusLabel(j.status) %> · <span class="badge <%= j.current.state === 'breached' ? 'err' : 'warn' %>"><%= slaBadge(j.current) %></span><%= j.area_confirmed ? '' : ' (area unconfirmed, provisional)' %></p><% }) %><% if (!d.overdue.length) { %><p class="muted">None</p><% } %></div>
  <div class="card"><h2>Compliance expiring (30 days)</h2><% d.compliance.forEach(function (c) { %><p><a href="/admin/contractors/<%= c.contractor_id %>"><%= c.legal_name %></a> · <%= humanize(c.doc_type) %> · <%= date(c.expires_at) %></p><% }) %><% if (!d.compliance.length) { %><p class="muted">None</p><% } %></div>
  <div class="card"><h2>Failures needing attention</h2><dl class="kv">
    <dt>Failed / reversed customer payments (30 d)</dt><dd><%= d.failures.failed_payments %></dd><dt>Pending customer payments</dt><dd><a href="/admin/payments"><%= d.failures.pending_payments %></a></dd>
    <dt>Failed accounting syncs</dt><dd><a href="/admin/integrations"><%= d.failures.failed_sync %></a></dd><dt>Syncs skipped (unconfigured)</dt><dd><%= d.failures.skipped_sync %></dd>
    <dt>Failed emails</dt><dd><a href="/admin/notifications"><%= d.failures.failed_notifications %></a></dd><dt>Emails not sent (no SMTP)</dt><dd><%= d.failures.unsent_notifications %></dd></dl></div>
</div>
<%- include('../partials/foot') %>
