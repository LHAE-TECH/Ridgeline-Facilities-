<%- include('../partials/head', { title: 'Notifications' }) %>
<div class="page-head"><h1>Notification outbox (email &amp; SMS)</h1><form method="post" action="/admin/worker/run"><%- include('../partials/csrf') %><button class="secondary" type="submit">Run background tasks now</button></form></div>
<p class="muted">"Not sent (unconfigured)" means the email or SMS provider is not set up: the message was recorded but NOT delivered. For SMS, "sent" means the provider accepted it; the handset result is shown as delivery status.</p>
<div class="card"><div class="table-wrap"><table><tr><th>Created</th><th>Channel</th><th>To</th><th>Subject / message</th><th>Status</th><th>Attempts</th></tr>
<% notifications.forEach(function (n) { %><tr><td><%= dt(n.created_at) %></td><td><%= n.channel.toUpperCase() %></td><td><%= n.channel === 'sms' ? n.recipient_phone : n.recipient_email %></td><td><details><summary><%= n.subject %></summary><pre style="white-space:pre-wrap"><%= n.body %></pre></details></td><td><%- include('../partials/status', { s: n.status, label: n.status === 'not_sent_unconfigured' ? 'Not sent (unconfigured)' : humanize(n.status) }) %><% if (n.last_error) { %><br><small><%= n.last_error %></small><% } %><% if (n.sent_at) { %><br><small><%= dt(n.sent_at) %></small><% } %><% if (n.delivery_status) { %><br><small>Delivery: <%= n.delivery_status %></small><% } %></td><td><%= n.attempts %></td></tr><% }) %></table></div></div>
<%- include('../partials/foot') %>
